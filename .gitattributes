# Normalize line endings on commit — always store as LF
* text=auto eol=lf

# Shell scripts must always be LF
*.sh text eol=lf

# Markdown and text files
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf

# Windows-specific files keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files — no line ending conversion
*.exe binary
*.dll binary
*.pdb binary
*.obj binary
*.lib binary
*.exp binary
*.ilk binary
*.png binary
*.jpg binary
*.ico binary
